{
  "name": "agent-attention",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "description": "Cross-agent notification plugin ecosystem for coding agents",
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "deps:check": "depcheck --ignore-patterns=spikes/**,ref/** --ignores=@agent-attention/*,typescript,tsup,vitest,eslint,prettier,@eslint/js,typescript-eslint,@types/node,tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint && npm run deps:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
